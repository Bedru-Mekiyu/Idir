# ==============================================================================
# RENDER.COM PRODUCTION ENVIRONMENT CONFIGURATION
# Copy and paste these environment variables into Render's "Environment" tab
# (Dashboard -> Web Service -> Environment -> Add from .env)
# ==============================================================================

APP_NAME="Idir Management Platform"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE="Africa/Addis_Ababa"
APP_LOCALE=am
APP_FALLBACK_LOCALE=en

# Set this to your actual Render web service URL (e.g. https://idir-platform.onrender.com)
APP_URL=https://idir-platform.onrender.com

# In production on Render, send logs to stderr so they stream to Render's live log viewer
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Database Configuration
# Default: SQLite (persisted automatically inside container, or use a Render PostgreSQL DB)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

# If using Render Managed PostgreSQL instead:
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:password@hostname:5432/dbname

# Run migrations automatically on container start
RUN_MIGRATIONS=true

# Session, Cache & Queue Settings (Stateless cookie & file for smooth serverless container scaling)
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email Notifications (Gmail SMTP or Resend)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=bedru.mekiyu-ug@aau.edu.et
MAIL_PASSWORD=fnpcxderisbysvnm
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bedru.mekiyu-ug@aau.edu.et
MAIL_FROM_NAME="Idir"

