APP_NAME="እድር (Idir Management Platform)"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE="Africa/Addis_Ababa"
APP_URL=http://localhost:8000

APP_LOCALE=am
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (PostgreSQL / SQLite)
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=idir_db
# DB_USERNAME=postgres
# DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Queue & Cache (Redis for Horizon)
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis
CACHE_STORE=database
# CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Ethiopian Payment Gateway - Chapa
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_PUBLIC_KEY=CHAPUBK_TEST-xxxxxxxx
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxx
CHAPA_WEBHOOK_SECRET=your_chapa_webhook_secret_here

# Ethiopian SMS Gateway - AfroMessage
AFROMESSAGE_BASE_URL=https://api.afromessage.com/api
AFROMESSAGE_TOKEN=your_afromessage_token_here
AFROMESSAGE_SENDER_ID=IDIR

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=idir_bot
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Fayda Digital ID - eSignet OIDC
FAYDA_BASE_URL=https://esignet.ida.fayda.et
FAYDA_CLIENT_ID=your_fayda_client_id_here
FAYDA_REDIRECT_URI="${APP_URL}/auth/fayda/callback"
FAYDA_SCOPES="openid profile phone"
FAYDA_PRIVATE_KEY_PATH="${storage_path}/keys/fayda_private.key"
FAYDA_KEY_ID="default-key-id"

# Broadcasting - Laravel Reverb
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=idir-app
REVERB_APP_KEY=idir-app-key
REVERB_APP_SECRET=idir-app-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# SMS Gateway Configuration
# Options: afromessage | geezsms | africastalking
# Change this one line to switch SMS providers — no code changes needed.
SMS_DRIVER=afromessage

# GeezSMS Ethiopian SMS Provider (alternative to AfroMessage)
# Sign up at geezsms.com → account → API to get your token
GEEZSMS_TOKEN=your_geezsms_token_here
GEEZSMS_SENDER_ID=IDIR
GEEZSMS_SHORTCODE_ID=

# Africa's Talking SMS Provider (pan-African fallback, confirmed Ethiopia coverage)
# Sign up at africastalking.com — sandbox works immediately with AT_USERNAME=sandbox
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_SHORTCODE=26950
AT_SENDER_ID=

# Telebirr Direct H5 Payment Gateway (Ethio Telecom)
# Register at: https://developer.ethiotelecom.et (requires business license + TIN for production)
# Sandbox available on portal registration without merchant approval
TELEBIRR_BASE_URL=https://app.ethiomobilemoney.et:2121/ammapi/payment/service-openup
TELEBIRR_APP_ID=your_telebirr_app_id_here
TELEBIRR_APP_KEY=your_telebirr_app_key_here
TELEBIRR_SHORT_CODE=your_telebirr_short_code_here
TELEBIRR_PUBLIC_KEY=  # Telebirr RSA public key for payload encryption (provided in portal docs)

# M-Pesa Ethiopia (Safaricom Ethiopia)
# Portal: https://developer.safaricom.et
# NOTE: MPESA_PASSKEY must be obtained directly from Safaricom Ethiopia developer support —
# it is not available via self-service signup as of this project's build, and no fallback/default value
# should ever be hardcoded. The driver requires this value to be explicitly configured.
MPESA_BASE_URL=https://sandbox.safaricom.et
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=your_mpesa_shortcode_here
MPESA_PASSKEY=your_mpesa_passkey_here
MPESA_CALLBACK_URL="${APP_URL}/api/mpesa/webhook"

# Email Notifications (Option A: Google Workspace / Gmail App Password)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_google_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Email Notifications (Option B: Resend - resend.com)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_your_resend_api_key_here
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=noreply@idir.et
# MAIL_FROM_NAME="${APP_NAME}"
